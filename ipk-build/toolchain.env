# ipk ビルド共通設定 (WSL 内から読み込む)
# 使い方: . /mnt/v/NAS/ipk-build/toolchain.env
CROSS_PREFIX="${CROSS_PREFIX:-$HOME/opt/cross/arm-linux-musleabihf-cross/bin/arm-linux-musleabihf-}"
export CC="${CROSS_PREFIX}gcc"
export CXX="${CROSS_PREFIX}g++"
export AR="${CROSS_PREFIX}ar"
export STRIP="${CROSS_PREFIX}strip"
export RANLIB="${CROSS_PREFIX}ranlib"
# 実機 = Cortina CS752x / Cortex-A9 x2 / NEON / VFPv3
export CFLAGS="${CFLAGS:--O2 -pipe -mcpu=cortex-a9 -mfpu=neon -mfloat-abi=hard -fno-common -I\$HOME/opt/cross/arm-linux-musleabihf-cross/arm-linux-musleabihf/include}"
export LDFLAGS="${LDFLAGS:--static -no-pie}"
# ipk の Architecture (実機 opkg.conf の許容値: g2 / arm_cortex-a9 / arm_cortex-a9_neon / arm_cortex-a9_vpf3 / all)
export IPK_ARCH="${IPK_ARCH:-arm_cortex-a9_neon}"
